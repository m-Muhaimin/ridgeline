# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# Comma-separated list of origins allowed to call state-changing /api routes from
# cross-origin pages (usually empty; same-origin requests are always allowed).
# APP_URL alone is sufficient when the frontend and API share a public origin.
ALLOWED_ORIGINS=""

# NEON_API_KEY: API Key for Neon platform authentication
NEON_API_KEY="MY_NEON_API_KEY"

# NEON POSTGRESQL & CLOUD BACKEND
DATABASE_URL="postgresql://user:your_password@your-host/neondb?sslmode=require"
DATABASE_URL_UNPOOLED="postgresql://user:your_password@your-host/neondb?sslmode=require"
NEON_BRANCH="production"
AWS_REGION="us-east-2"
AWS_ACCESS_KEY_ID="MY_NEON_S3_KEY_ID"
AWS_SECRET_ACCESS_KEY="MY_NEON_S3_SECRET"
AWS_ENDPOINT_URL_S3="https://your-s3-gateway.example.com"
NEON_FUNCTION_API_BASE_URL="https://your-function-base.example.com"

# TWILIO TELEPHONY & SMS DISPATCH INTEGRATION
TWILIO_ACCOUNT_SID="ACxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx"
TWILIO_AUTH_TOKEN="your_twilio_auth_token"
TWILIO_PHONE_NUMBER="+15557824309"

# OPENAI-COMPATIBLE LLM / AI GATEWAY SETTINGS
# Endpoint URL for OpenAI-compatible completions & chat (e.g. vLLM, Ollama, LiteLLM)
OPENAI_COMPATIBLE_BASE_URL="https://your-gateway-address.example.com/v1"
OPENAI_COMPATIBLE_API_KEY=""
OPENAI_COMPATIBLE_MODEL="gemini/gemini-3.8-flash"

# SESSION & COOKIE SIGNING SECRETS (REQUIRED for any shared/deployed environment;
# without them the server boots with per-process ephemeral secrets and every
# restart invalidates all sessions). Generate long random values, e.g. openssl rand -hex 32.
JWT_SECRET="replace_with_a_long_random_value"
SESSION_SECRET="replace_with_a_long_random_value"
COOKIE_SECRET="replace_with_a_long_random_value"

# ---------------------------------------------------------------------------
# DOCKER COMPOSE
# ---------------------------------------------------------------------------
# `docker compose up -d --build` reads a gitignored .env in the repo root and
# interpolates it into docker-compose.yml. Everything above is the same contract
# the stack needs; this section re-states it and adds the two variables that
# exist only for Docker. Nothing here is duplicated as a second assignment, so
# there is no "which one wins" trap.
#
# APP_URL (REQUIRED here): it is declared above — set that one to the exact
# public origin the browser uses, scheme + host + port, no trailing slash, e.g.
# APP_URL="https://your-domain.example.com"
# It is rebuilt into the Twilio signature validation URL, so a wrong value makes
# every webhook 403, and it seeds the same-origin allow-list for state-changing
# /api calls. With the compose stack on http://localhost it is literally
# "http://localhost".

# WEB_API_ORIGIN: address the *web container* uses for its /api/* rewrite, at
# build time and at runtime. Only change it if the API is not the compose
# service named `api`. Do not set API_ORIGIN yourself for the compose stack.
WEB_API_ORIGIN="http://api:3000"

# NODE_ENV: leave unset for production. "development" is a local plain-HTTP
# escape hatch only — it re-enables the Twilio signature bypass and drops the
# Secure flag from the session cookie.
# NODE_ENV="production"

# Everything else is passed straight through to the api service:
#   DATABASE_URL (and DATABASE_URL_UNPOOLED), JWT_SECRET, SESSION_SECRET,
#   COOKIE_SECRET, TWILIO_ACCOUNT_SID, TWILIO_AUTH_TOKEN, TWILIO_PHONE_NUMBER,
#   OPENAI_COMPATIBLE_BASE_URL, OPENAI_COMPATIBLE_API_KEY,
#   OPENAI_COMPATIBLE_MODEL, GEMINI_API_KEY, ALLOWED_ORIGINS, and the optional
#   NEON_PROJECT_ID, NEON_BRANCH, NEON_FUNCTION_API_BASE_URL, AWS_REGION,
#   AWS_ENDPOINT_URL_S3, AWS_ACCESS_KEY_ID, AWS_SECRET_ACCESS_KEY.
# Nothing is baked into an image: no layer, no compose file, and no .env file
# ever gets committed.
